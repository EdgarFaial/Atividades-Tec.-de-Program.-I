<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adivinhe o Número</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 50px;
            background-color: #f0f0f0;
        }
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            max-width: 500px;
            margin: 0 auto;
        }
        input, button {
            padding: 10px;
            margin: 10px;
            font-size: 16px;
        }
        .sucesso {
            color: green;
            font-weight: bold;
            font-size: 20px;
        }
        .erro {
            color: red;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Adivinhe o Número!</h1>
        <p>Digite um número entre 1 e 100:</p>
        
        <% if (mensagem) { %>
            <p>Você digitou: <strong><%= palpite %></strong></p>
            <% if (acertou) { %>
                <p class="sucesso"><%= mensagem %></p>
                <form method="POST" action="/novo-jogo">
                    <button type="submit">Jogar novamente</button>
                </form>
            <% } else { %>
                <p class="erro"><%= mensagem %></p>
            <% } %>
        <% } %>
        
        <% if (!acertou) { %>
            <form method="POST" action="/">
                <input type="number" name="palpite" min="1" max="100" required autofocus>
                <button type="submit">Enviar</button>
            </form>
        <% } %>
    </div>
</body>
</html>