<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhes - Meu Site</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Meu Site</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/contato">Contato</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/detalhes">Detalhes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/produto">Produtos</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Fotos
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/fotos">Galeria</a></li>
                            <li><a class="dropdown-item" href="#">Outra ação</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <!-- List group -->
        <ul class="list-group mb-4">
            <li class="list-group-item">Item 1 - Informação relevante</li>
            <li class="list-group-item">Item 2 - Outro detalhe importante</li>
            <li class="list-group-item">Item 3 - Característica do produto</li>
            <li class="list-group-item">Item 4 - Especificação técnica</li>
        </ul>

        <!-- Accordion -->
        <div class="accordion" id="accordionDetalhes">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#detalhe1">
                        Mais detalhes técnicos
                    </button>
                </h2>
                <div id="detalhe1" class="accordion-collapse collapse show" data-bs-parent="#accordionDetalhes">
                    <div class="accordion-body">
                        Conteúdo detalhado sobre as especificações. Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#detalhe2">
                        Dimensões e peso
                    </button>
                </h2>
                <div id="detalhe2" class="accordion-collapse collapse" data-bs-parent="#accordionDetalhes">
                    <div class="accordion-body">
                        10cm x 5cm x 2cm, 150g.
                    </div>
                </div>
            </div>
        </div>
